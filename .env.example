# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (read by compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string for the app: postgres://USER:PASSWORD@127.0.0.1:5432/DB
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SMTP_URL=
OWNER_EMAIL=
